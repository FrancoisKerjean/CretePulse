{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    { "path": "/api/cron/reviews-cleanup", "schedule": "0 3 * * *" },
    { "path": "/api/cron/car-no-quote", "schedule": "0 * * * *" },
    { "path": "/api/cron/car-relance", "schedule": "0 9 * * *" },
    { "path": "/api/cron/activity-no-quote", "schedule": "30 * * * *" },
    { "path": "/api/cron/activity-relance", "schedule": "10 9 * * *" },
    { "path": "/api/cron/newsletter", "schedule": "0 5 * * 1" },
    { "path": "/api/cron/stays-balance", "schedule": "20 9 * * *" }
  ]
}
